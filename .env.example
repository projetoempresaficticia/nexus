# =========================================================
# Nexus v2 — variáveis de ambiente (EXEMPLO, sem valores reais)
# Copie para .env (que está no .gitignore) e preencha.
# O Angular NÃO lê este arquivo: usa src/environments/*.ts
# =========================================================

# --- Supabase local (mostrado por `npx supabase status`) ---
SUPABASE_URL=                 # ex.: http://127.0.0.1:54321
SUPABASE_ANON_KEY=            # chave pública (pode ir ao frontend)
SUPABASE_SERVICE_ROLE_KEY=    # SECRETA — só scripts/ e Edge Functions. NUNCA no frontend nem no Git

# --- Login Google (config.toml usa via env(...)) ---
GOOGLE_CLIENT_ID=             # cliente OAuth do Google Cloud
GOOGLE_CLIENT_SECRET=         # SECRETA

# --- E-mails (Edge Function enviar-notificacoes) ---
RESEND_API_KEY=               # SECRETA (⚠️ provedor a confirmar)
EMAIL_REMETENTE=              # ex.: Nexus <nexus@estudeemportugal.org>
APP_URL=                      # ex.: http://localhost:4200  |  https://<usuario>.github.io/nexus
CRON_SECRET=                  # SECRETA — protege a chamada do pg_cron à Edge Function

# --- Importação do v26 (scripts/importar-v26.ts) ---
V26_CSV_DIR=                  # pasta com os CSVs exportados das abas (fora do repositório!)
