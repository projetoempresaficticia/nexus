#!/usr/bin/env bash
# Mantém commits pequenos e protege a main — ver docs/COMMITS.md
AVISO=200     # a partir daqui: avisa
LIMITE=400    # a partir daqui: pede confirmação

branch="$(git symbolic-ref --short -q HEAD)"
if [ "$branch" = "main" ]; then
  echo "✖ Não commite direto na main. Crie a branch da tarefa: git switch -c T-XX/resumo-curto"
  exit 1
fi

# Nunca commitar segredos
if git diff --cached --name-only | grep -Eq '(^|/)\.env($|\.)' ; then
  if git diff --cached --name-only | grep -Ev '\.env\.example$' | grep -Eq '(^|/)\.env'; then
    echo "✖ Há um arquivo .env no commit. Remova com: git restore --staged <arquivo>"
    exit 1
  fi
fi
if git diff --cached -U0 | grep -Eiq '^\+.*(service_role|SERVICE_ROLE_KEY\s*[:=]\s*["'\'']?ey)'; then
  echo "✖ Parece haver uma chave service_role no commit. Ela nunca pode ir para o Git."
  exit 1
fi

# Conta linhas alteradas, ignorando arquivos gerados
linhas="$(git diff --cached --numstat -- . \
  ':(exclude)package-lock.json' ':(exclude)**/database.types.ts' ':(exclude)referencias/**' \
  | awk '{ if ($1 != "-") s += $1 + $2 } END { print s + 0 }')"

if [ "$linhas" -ge "$LIMITE" ]; then
  echo ""
  echo "⚠  Este commit altera $linhas linhas (limite sugerido: $AVISO)."
  echo "   Considere dividir com 'git restore --staged <arquivo>' ou 'git add -p'."
  if [ -t 1 ] && [ -r /dev/tty ]; then
    printf "   Continuar mesmo assim? [s/N] "
    read -r resp < /dev/tty
    case "$resp" in s|S|sim|SIM) exit 0 ;; *) echo "   Commit cancelado."; exit 1 ;; esac
  else
    echo "   (sem terminal interativo: commit bloqueado — divida em commits menores)"
    exit 1
  fi
elif [ "$linhas" -ge "$AVISO" ]; then
  echo "⚠  Commit com $linhas linhas. Tudo bem, mas o ideal é até ~150 — ver docs/COMMITS.md."
fi
exit 0
